# Copia a `api/.env` localmente (no commitear).

NODE_ENV=production
PORT=7000
TRUST_PROXY=1

TURNSTILE_SECRET_KEY=

MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_FROM=
MAIL_TO=

ALLOWED_ORIGINS=

# --- Base de datos MySQL 5.7 (opcional - sin esto solo funciona el e-mail) ---
# En el VPS (Docker) DB_HOST es el nombre del servicio: mysql
# Localmente con MySQL nativo usa 127.0.0.1
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=ourstory
# DB_PASSWORD=
# DB_NAME=ourstory
#
# --- Credenciales del contenedor MySQL (Docker Compose, VPS) ---
# El servicio mysql del compose lee estas claves; deben coincidir con DB_*.
# MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE=ourstory
# MYSQL_USER=ourstory
# MYSQL_PASSWORD=

# --- Privacidad: hash HMAC-SHA256 de la IP (recomendado, pero opcional) ---
# Genera con: openssl rand -hex 32
# IP_HASH_SECRET=

# --- Moderación de recados por e-mail ---
# APPROVE_SECRET: clave para firmar los links de aprobación (HMAC-SHA256 por recado)
#   Genera con: openssl rand -hex 32
# APPROVE_SECRET=
#
# API_BASE_URL: URL pública de esta API (se usa para armar el link de aprobación en el e-mail)
#   Ej.: http://66.179.211.195
# API_BASE_URL=

# --- Contenido editable (Fase 3) ---
# ADMIN_TOKEN: token Bearer para PUT /api/contenido (el panel /admin lo pide al entrar)
#   Genera con: openssl rand -hex 32
# ADMIN_TOKEN=
#
# GITHUB_TOKEN: PAT con scope "workflow" para disparar el rebuild tras un PUT
# GITHUB_REPO: repositorio "owner/repo" del sitio (p. ej. ValenzuelaxD/our-story)
# GITHUB_REPO=ValenzuelaxD/our-story
#
# MAIL_NOME_ELE: nombre que firma los e-mails (por defecto: Davi)
# MAIL_NOME_ELE=Davi