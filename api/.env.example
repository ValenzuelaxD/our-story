# Copia a `api/.env` localmente (no commitear).

NODE_ENV=production
PORT=7000
TRUST_PROXY=1

TURNSTILE_SECRET_KEY=

MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_FROM=
MAIL_TO=

ALLOWED_ORIGINS=

# --- Base de datos MySQL 5.7 (opcional - sin esto solo funciona el e-mail) ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=ourstory

# --- Privacidad: hash HMAC-SHA256 de la IP (recomendado, pero opcional) ---
# Genera con: openssl rand -hex 32
# IP_HASH_SECRET=

# --- Moderación de recados por e-mail ---
# APPROVE_SECRET: clave para firmar los links de aprobación (HMAC-SHA256 por recado)
#   Genera con: openssl rand -hex 32
# APPROVE_SECRET=
#
# API_BASE_URL: URL pública de esta API (se usa para armar el link de aprobación en el e-mail)
#   Ej.: http://66.179.211.195
# API_BASE_URL=