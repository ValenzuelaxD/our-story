# Copia a `.env` en la raíz (no commitear).
# Usa URL completa con https://. En GitHub Actions el secret RECADOS_API_URL puede omitir el https://.

VITE_RECADOS_API_URL=
VITE_TURNSTILE_SITE_KEY=

# ID de medición (opcional, ej.: G-XXXXXXXX). El aviso de cookies solo aparece si está definido. En CI: secret VITE_GA_MEASUREMENT_ID.
VITE_GA_MEASUREMENT_ID=

# URL pública del sitio (https://…), usada en el build para generar sitemap.xml con <image:image>.
# Alternativa: VITE_SITE_URL=… (lo lee el mismo script) o SITE_ORIGIN en src/data/constants.js.
# En GitHub Actions: secret SITE_URL (mismo valor de la URL canónica en Search Console).
SITE_URL=